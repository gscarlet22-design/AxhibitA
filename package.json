{
  "name": "axhibit",
  "productName": "Axhibit A",
  "version": "1.1.2",
  "description": "Player and evidence-safe clip exporter for AXIS Camera Station Pro exports",
  "author": "Garrett Scarlett",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/features.mjs",
    "bench:export": "node scripts/bench-export.mjs",
    "lint": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
